# ──────────────────────────────────────────────────────
#  Greenway Golf — Environment Config
#  For LOCAL dev: credentials are hardcoded in docker-compose.yml
#  This file is only needed for PRODUCTION overrides
# ──────────────────────────────────────────────────────

# ── Django ─────────────────────────────────────────────
SECRET_KEY=replace-with-50-random-chars-run-openssl-rand-base64-50
DEBUG=False

# ── Database ───────────────────────────────────────────
DB_NAME=greenway_db
DB_USER=greenway
DB_PASSWORD=change_this_strong_password

# ── Hosts (comma-separated) ────────────────────────────
# LOCAL:      localhost,127.0.0.1,backend
# PRODUCTION: yourdomain.com,www.yourdomain.com,backend
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── CORS (comma-separated full origins) ────────────────
# LOCAL:      http://localhost:8080
# PRODUCTION: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Gunicorn ───────────────────────────────────────────
# Rule of thumb: 2 × CPU cores + 1
GUNICORN_WORKERS=3
